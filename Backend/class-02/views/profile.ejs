<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

      
    <%- include('components/header') %>


    <h1>User Profile</h1>

    <ul>
        <li>Name : <%= user.name %>
        </li>
        <li>Email : <%= user.email %>
        </li>
        <li>Address : <%= user.address %>
        </li>
        <li>Contact : <%= user.contact %>
        </li>
    </ul>

    <h3>Skills</h3>

    <ul>
        <% user.skills.forEach(skill=> { %>
            <li>
                <%= skill %>
            </li>
            <% }); %>
    </ul>


    <h3>Experience</h3>

    <% if(user.experience> 2){ %>
        <h4>Senior</h4>
        <% }else{ %>
            <h4>Junior</h4>
            <% } %>


</body>

</html>